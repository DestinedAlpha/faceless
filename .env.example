# =============================================================================
# Free API keys — copy this file to `.env` and fill in. ALL are free, no card.
# Nothing here is required to *start*: edge-tts + Pollinations + Remotion run
# with zero keys. Keys unlock trends (YouTube/Reddit), better LLM, stock B-roll.
# =============================================================================

# --- LLM (script + selection + metadata) -------------------------------------
# Google AI Studio -> https://aistudio.google.com/apikey  (free, no card)
GEMINI_API_KEY=
# Groq (fallback LLM + Whisper) -> https://console.groq.com/keys  (free)
GROQ_API_KEY=

# --- Trend discovery ---------------------------------------------------------
# YouTube Data API v3 key (same Google Cloud project as Gemini works too)
# https://console.cloud.google.com/apis/credentials  (enable "YouTube Data API v3")
YOUTUBE_API_KEY=
# Reddit script app -> https://www.reddit.com/prefs/apps  (type: "script")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=faceless-video-gen/0.1 by u/yourusername

# --- Stock B-roll ------------------------------------------------------------
# Pexels -> https://www.pexels.com/api/  (free key instantly)
PEXELS_API_KEY=
# Pixabay -> https://pixabay.com/api/docs/  (free key instantly)
PIXABAY_API_KEY=

# --- Images backup (optional; Pollinations is primary and needs no key) ------
# Cloudflare Workers AI -> account id + API token with "Workers AI" read
# https://dash.cloudflare.com/  ->  AI  ->  Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Analytics learn loop (Phase 6; all optional) ----------------------------
# The learn loop works with ZERO keys via the manual metrics_inbox.jsonl path.
# For the automated pull, create a free "Desktop app" OAuth client in Google
# Cloud (enable YouTube Data API v3 + YouTube Analytics API), download the JSON,
# and point this at it (or drop it at memory/client_secret.json). One-time consent.
YOUTUBE_OAUTH_CLIENT_SECRET=
